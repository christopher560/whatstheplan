---
import "@/styles/global.css";
import "../styles/dashboard-base.css";
import BaseHead from "@/components/utility/BaseHead.astro";
import SkipLink from "@/components/global/SkipLink.astro";

interface Props {
  title?: string;
}

const { title = "Log in" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} noindex />
  </head>

  <body>
    <SkipLink />
    <div class="auth-layout_wrap">
      <main class="auth-layout_form" id="main-content">
        <slot />
      </main>
      <div class="auth-layout_aside">
        <slot name="aside" />
      </div>
    </div>
  </body>
</html>

<style is:global>
  @layer components {
    .auth-layout_wrap {
      flex: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      min-height: 100svh;
      background-color: var(--background);

      @media (width < 56rem) {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    /*
     * Type and spacing stop growing at 1440px, so on a big screen the card and
     * panel would sit small in a lot of background. Zoom scales them up in
     * steps, and each step needs the window to be tall enough to still hold the
     * content (the card is about 46rem tall, the panel about 56rem).
     */
    .auth-layout_wrap {
      --_zoom: 1;
      --_aside-zoom: 1;

      @media (width >= 106rem) and (height >= 58rem) {
        --_zoom: 1.08;
      }
      @media (width >= 119rem) and (height >= 64rem) {
        --_zoom: 1.15;
      }
      @media (width >= 144rem) and (height >= 74rem) {
        --_zoom: 1.25;
      }
      @media (width >= 175rem) and (height >= 88rem) {
        --_zoom: 1.45;
      }

      @media (width >= 106rem) and (height >= 62rem) {
        --_aside-zoom: 1.05;
      }
      @media (width >= 119rem) and (height >= 68rem) {
        --_aside-zoom: 1.12;
      }
      @media (width >= 144rem) and (height >= 82rem) {
        --_aside-zoom: 1.22;
      }
      @media (width >= 175rem) and (height >= 98rem) {
        --_aside-zoom: 1.4;
      }
    }

    .auth-layout_form > * {
      zoom: var(--_zoom);
    }

    .auth-layout_aside > * {
      zoom: var(--_aside-zoom);
    }

    .auth-layout_form {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-5) var(--site-margin);
    }

    .auth-layout_aside {
      display: flex;
      min-width: 0;

      @media (width < 56rem) {
        display: none;
      }
    }
  }
</style>
