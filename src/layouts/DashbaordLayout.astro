---
import "@/styles/global.css";
import BaseHead from "@/components/utility/BaseHead.astro";
import SkipLink from "@/components/global/SkipLink.astro";
import DashboardSidebar from "@/components/global/DashboardSidebar.astro";
import DashboardTabBar from "@/components/global/DashboardTabBar.astro";
import { dashboardRepo } from "@/lib/dashboard-repo.ts";
import { nearestAccent } from "@/utils/avatar-accent.ts";
import { countPending } from "@/lib/plans-db.ts";
import { countFriendRequests } from "@/lib/friends-db.ts";
import "../styles/dashboard.css";
import "../styles/dashboard-base.css";

interface Props {
  title?: string;
}

const { title = "Dashboard" } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "");
const shell = await dashboardRepo.getShell();
/* The sample viewer is replaced by the signed-in person's own name and color. */
const me = Astro.locals.profile;
/* Someone with no first name yet shows as their @username. */
const shownName = me?.first_name || (me?.username ? `@${me.username}` : "");
if (shownName) {
  shell.viewer = { ...shell.viewer, name: shownName, color: nearestAccent(me?.avatar_color) };
}
/* The friend count is the number of accepted friendships; row level security limits this to the person's own. */
if (Astro.locals.user) {
  const { count } = await Astro.locals.supabase
    .from("friendships")
    .select("id", { count: "exact", head: true })
    .eq("status", "accepted");
  shell.viewer = { ...shell.viewer, friendCount: count ?? 0 };
  /* The badges count invites and friend requests the person has not answered. */
  const [plans, friends] = await Promise.all([
    countPending(Astro.locals.supabase, Astro.locals.user.id),
    countFriendRequests(Astro.locals.supabase, Astro.locals.user.id),
  ]);
  shell.badges = { plans, friends };
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} />
    <script is:inline>
      /* Tells the server the person's time zone, so "this week" and "tonight" are theirs. */
      document.cookie = "tz=" + Intl.DateTimeFormat().resolvedOptions().timeZone + ";path=/;max-age=31536000;samesite=lax";
    </script>
  </head>

  <body>
    <SkipLink />

    <div class="dashboard_sidebar_shell">
      <DashboardSidebar shell={shell} pathname={pathname} />

      <main class="dashboard_main" id="main-content">
        <slot />
      </main>
    </div>

    <DashboardTabBar shell={shell} pathname={pathname} />
  </body>
</html>
