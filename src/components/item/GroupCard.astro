---
import Panel from "@/components/wrapper/Panel.astro";
import Pill from "@/components/item/Pill.astro";
import ActionButton from "@/components/item/ActionButton.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <Panel tag="article" class="group-card_wrap" data-card>
      <div class="group-card_top">
        <Pill size="tiny" variant="filled" color="blue" data-category>
          Category
        </Pill>
        <Pill size="tiny" data-when-chip>
          When
        </Pill>
      </div>
      <h3 class="group-card_title text-style-h4" data-title />
      <p class="group-card_purpose text-style-small" data-purpose />
      <p class="group-card_where text-style-small" data-where />
      <div class="group-card_crew">
        <span class="avatar-stack_wrap" data-stack></span>
        <p class="group-card_going text-style-small" data-going />
      </div>
      <div class="group-card_tags" data-tags></div>
      <div class="group-card_buttons">
        <ActionButton element="link" href="#" color="ink" class="group-card_open" hidden data-open-group>
          Open group
        </ActionButton>
        <ActionButton class="group-card_join" data-join>
          Join
        </ActionButton>
      </div>
    </Panel>
  )
}

<style is:global>
  @layer components {
    .group-card_wrap {
      gap: var(--space-3);
      height: 100%;
    }

    .group-card_top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2);
    }

    .group-card_title {
      font-weight: var(--secondary-bold);
    }

    .group-card_purpose {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      color: var(--text-2);
    }

    .group-card_where {
      font-weight: var(--primary-bold);
    }

    .group-card_crew {
      display: flex;
      align-items: center;
      gap: var(--space-2);

      & .avatar-stack_wrap {
        flex: none;
        flex-wrap: nowrap;
      }
    }

    .group-card_going {
      min-width: 0;
      font-weight: var(--primary-bold);
    }

    .group-card_tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1);
    }

    .group-card_buttons {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-block-start: auto;

      & > * {
        flex: 1 1 auto;
      }

      & [hidden] {
        display: none;
      }
    }

    /* A card for a group you are in opens that group, anywhere you click that is not a button. */
    .group-card_wrap.clickable {
      cursor: pointer;
    }
  }
</style>
