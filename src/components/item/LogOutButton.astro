---
import ActionButton from "@/components/item/ActionButton.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Button size. */
  size?: "small" | "main";
  class?: string;
}

const { render = true, size = "small", class: className } = Astro.props;
---

{
  render && (
    <ActionButton color="white" size={size} class={className} data-logout>
      Log out
    </ActionButton>
  )
}

<script>
  import { logOut } from "@/lib/auth-repo.ts";

  /* Ends the session on the server, then opens the login page. */
  document.querySelectorAll<HTMLButtonElement>("[data-logout]").forEach((button) =>
    button.addEventListener("click", async () => {
      button.disabled = true;
      const result = await logOut();
      location.assign(result.ok ? result.next : "/login");
    }),
  );
</script>
