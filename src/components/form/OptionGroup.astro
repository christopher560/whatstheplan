---
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Unique id for the group label. */
  id: string;
  /** Group label. */
  label: string;
  /** Shared radio name, also the profile field. */
  name: string;
  /** Choices, each with a stable id. */
  options?: { id: string; label: string; sub?: string }[];
  /** Id picked at the start. */
  value?: string;
  /** Lay the choices out in columns. */
  columns?: boolean;
}

const {
  render = true,
  id,
  label,
  name,
  options = [],
  value,
  columns = false,
} = Astro.props;
---

{
  render && options.length > 0 && (
    <div class="option-group_wrap" role="radiogroup" aria-labelledby={id}>
      <p id={id} class="option-group_label text-style-main">{label}</p>
      <div class:list={["option-group_options", columns && "columns"]}>
        {options.map((option) => (
          <label class="option-group_option">
            <input
              class="option-group_input"
              type="radio"
              name={name}
              value={option.id}
              checked={option.id === value}
            />
            <span class="option-group_text">
              <span class="option-group_name text-style-main">{option.label}</span>
              {option.sub && (
                <span class="option-group_sub text-style-small">{option.sub}</span>
              )}
            </span>
          </label>
        ))}
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .option-group_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      min-width: 0;
    }

    .option-group_label {
      font-weight: var(--primary-bold);
    }

    .option-group_options {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);

      &.columns {
        grid-template-columns: repeat(
          auto-fit,
          minmax(min(100%, var(--card-width-small)), 1fr)
        );
      }
    }

    .option-group_option {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      min-height: 4rem;
      padding: var(--space-3) var(--space-4);
      border: var(--border-width-medium) solid var(--border);
      border-radius: var(--radius-main);
      background-color: var(--background-3);
      cursor: pointer;
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease),
        box-shadow var(--hover-duration) var(--hover-ease);

      &:has(:checked) {
        border-color: var(--border-strong);
        background-color: var(--colors-secondary-yellow);
        box-shadow: 0 0 0 var(--border-width) var(--border-strong);
      }
      &:has(:focus-visible) {
        outline: var(--focus-width) solid var(--text);
        outline-offset: var(--focus-offset);
      }
    }

    .option-group_input {
      flex: none;
      appearance: none;
      width: var(--icon-main);
      aspect-ratio: 1 / 1;
      margin: 0;
      border: var(--border-width-thick) solid var(--border-strong);
      border-radius: var(--radius-round);
      background-color: var(--background-3);
      transition: box-shadow var(--hover-duration) var(--hover-ease);

      &:checked {
        background-color: var(--text);
        box-shadow: inset 0 0 0 var(--space-0) var(--background-3);
      }
      &:focus-visible {
        outline: 0;
      }
    }

    .option-group_text {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      min-width: 0;
    }

    .option-group_name {
      font-weight: var(--primary-bold);
    }

    .option-group_sub {
      color: var(--text-2);
    }
  }
</style>
