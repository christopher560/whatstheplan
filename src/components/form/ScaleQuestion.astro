---
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Answer key, shared with the `data-style` hook. */
  id: string;
  /** The question. */
  question: string;
  /** Label for answer 1. */
  lo: string;
  /** Label for answer 5. */
  hi: string;
  /** Answer picked at the start, 1 to 5. */
  value?: number | null;
}

const { render = true, id, question, lo, hi, value = null } = Astro.props;
---

{
  render && (
    <div
      class="scale-question_wrap"
      role="group"
      aria-labelledby={`question-${id}`}
    >
      <p id={`question-${id}`} class="scale-question_label text-style-large">
        {question}
      </p>
      <div class="scale-question_scale">
        {[1, 2, 3, 4, 5].map((n) => (
          <label class="scale-question_item">
            <input
              class="scale-question_input"
              type="radio"
              name={`style-${id}`}
              value={n}
              checked={value === n}
              aria-label={`${lo} to ${hi}: ${n} of 5`}
              data-style={id}
            />
            <span class="scale-question_mark" />
          </label>
        ))}
      </div>
      <div class="scale-question_ends">
        <span class="text-style-small">{lo}</span>
        <span class="text-style-small">{hi}</span>
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .scale-question_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      min-width: 0;
    }

    .scale-question_label {
      font-weight: var(--primary-bold);
    }

    .scale-question_scale {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--space-2);
    }

    .scale-question_item {
      display: flex;
      justify-content: center;
      cursor: pointer;
    }

    .scale-question_input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }

    .scale-question_mark {
      width: 100%;
      max-width: 4rem;
      min-height: var(--control-height-small);
      aspect-ratio: 1 / 1;
      border: var(--border-width-thick) solid var(--border);
      border-radius: var(--radius-round);
      background-color: var(--background-3);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease),
        box-shadow var(--hover-duration) var(--hover-ease),
        translate var(--move-duration) var(--ease-out);

      @media (hover: hover) {
        .scale-question_item:hover & {
          translate: 0 var(--hover-lift);
        }
      }
      .scale-question_input:checked + & {
        border-color: var(--border-strong);
        background-color: var(--colors-vivid-yellow);
        box-shadow: var(--shadow-offset-small);
      }
      .scale-question_input:focus-visible + & {
        outline: var(--focus-width) solid var(--text);
        outline-offset: var(--focus-offset);
      }
    }

    .scale-question_ends {
      display: flex;
      justify-content: space-between;
      gap: var(--space-3);
      color: var(--text-2);
      font-weight: var(--primary-medium);

      & > :last-child {
        text-align: end;
      }
    }
  }
</style>
