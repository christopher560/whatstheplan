---
import type { HTMLAttributes } from "astro/types";
import type { ShellData } from "@/lib/dashboard-repo.ts";
import Icon from "@/components/media/Icon.astro";
import NavIcon from "@/components/media/NavIcon.astro";
import icon_plus from "@/assets/icons/icon_plus.svg";

interface Props extends HTMLAttributes<"nav"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Navigation and badge counts. */
  shell?: ShellData;
  /** Path of the current page, used to mark the active tab. */
  pathname?: string;
  /** Where the center button goes. */
  addHref?: string;
}

const {
  render = true,
  shell,
  pathname = "",
  addHref = "/app/dashboard#builder",
  class: className,
  ...rest
} = Astro.props;

const isActive = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`);

const half = shell ? Math.ceil(shell.nav.length / 2) : 0;
---

{
  render && shell && (
    <nav
      class:list={["dashboard-tabs_wrap", className]}
      aria-label="Main"
      {...rest}
    >
      {shell.nav.map((item, index) => (
        <Fragment>
          {index === half && (
            <a class="dashboard-tabs_add" href={addHref} aria-label="Start a plan">
              <Icon src={icon_plus} />
            </a>
          )}
          <a
            class="dashboard-tabs_link"
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            <span class="dashboard-tabs_icon">
              <NavIcon name={item.id} />
              {item.badge && (
                <span
                  class="dashboard-tabs_badge"
                  hidden={shell.badges[item.badge] === 0}
                  data-badge={item.badge}
                  aria-label={`${shell.badges[item.badge]} new`}
                >
                  {shell.badges[item.badge]}
                </span>
              )}
            </span>
            <span class="dashboard-tabs_label">{item.label}</span>
          </a>
        </Fragment>
      ))}
    </nav>
  )
}

<style is:global>
  @layer components {
    .dashboard-tabs_wrap {
      --_height: 5rem;
      position: fixed;
      inset-inline: 0;
      inset-block-end: 0;
      z-index: 9999;
      display: none;
      align-items: flex-start;
      justify-content: space-around;
      gap: var(--space-0);
      height: calc(var(--_height) + env(safe-area-inset-bottom));
      padding: var(--space-1) var(--space-1) env(safe-area-inset-bottom);
      border-block-start: var(--border-width) solid var(--border-subtle);
      background-color: var(--background-3);

      @media (width < 48rem) {
        display: flex;
      }
    }

    .dashboard-tabs_link {
      flex: 1 1 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-0);
      min-width: 0;
      min-height: 3.5rem;
      border-radius: var(--radius-main);
      color: var(--colors-on-vivid);
      font-size: var(--text-tiny);
      font-weight: var(--primary-bold);
      line-height: 1.2;
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        scale var(--hover-duration) var(--ease-spring);

      &:active {
        scale: 0.92;
      }
      &:focus-visible {
        outline: var(--focus-width) solid currentColor;
        outline-offset: calc(var(--focus-width) * -1);
      }
      &[aria-current="page"] {
        background-color: var(--colors-secondary-yellow-strong);
      }
    }

    .dashboard-tabs_icon {
      position: relative;
      display: inline-flex;
    }

    .dashboard-tabs_label {
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .dashboard-tabs_badge {
      position: absolute;
      inset-block-start: calc(var(--space-1) * -1);
      inset-inline-start: 55%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: var(--space-3);
      height: var(--space-3);
      padding-inline: var(--space-0);
      border: var(--border-width-thick) solid var(--background-3);
      border-radius: var(--radius-round);
      background-color: var(--badge-background, #e5484d);
      color: var(--light-100);
      font-size: var(--text-tiny);
      line-height: 1;

      &[hidden] {
        display: none;
      }
    }

    .dashboard-tabs_add {
      flex: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--avatar-large);
      aspect-ratio: 1 / 1;
      margin-block-start: calc(var(--space-6) * -0.6);
      border: var(--border-width-thick) solid var(--border-strong);
      border-radius: var(--radius-round);
      background-color: var(--colors-vivid-orange);
      box-shadow: var(--shadow-offset-small);
      color: var(--colors-on-vivid);
      font-size: var(--text-large);
      transition:
        translate var(--move-duration) var(--ease-out),
        scale var(--hover-duration) var(--ease-spring),
        box-shadow var(--hover-duration) var(--hover-ease);

      &:active {
        scale: 0.95;
        translate: 0 0.125rem;
        box-shadow: none;
      }
      &:focus-visible {
        outline: var(--focus-width) solid var(--text);
        outline-offset: var(--focus-offset);
      }
    }
  }
</style>
