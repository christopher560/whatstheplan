---
import type { PlanDetail } from "@/data/plan-detail.ts";

interface Props {
  /** The plan the replies components start from. */
  plan?: PlanDetail;
}

const { plan } = Astro.props;
---

{
  plan && (
    <script
      is:inline
      type="application/json"
      id="plan-data"
      set:html={JSON.stringify(plan).replace(/</g, "\\u003c")}
    />
  )
}

<script>
  import { poll, reloadWhenIdle } from "@/lib/live.ts";
  import { livePlan, livePulse } from "@/lib/live-repo.ts";
  import { applyLive, getPlan } from "@/lib/plan-store.ts";

  /* The host's plan page: replies, votes and the feed arrive while it is open. */
  if (document.getElementById("plan-data")) {
    const id = getPlan().id;
    poll({
      pulse: () => livePulse("plan", id),
      load: () => livePlan(id),
      apply: (plan) => {
        if (applyLive(plan) === "reload") reloadWhenIdle();
      },
    });
  }
</script>
