---
import ActionButton from "@/components/item/ActionButton.astro";
import PathIcon from "@/components/media/PathIcon.astro";
import type { Invite } from "@/data/invite.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The plan, for the host's updates and the time that won. */
  invite?: Invite;
}

const { render = true, invite } = Astro.props;
---

{
  render && invite && (
    <div class="invite-steps_panel invite-done_wrap" data-step="done" hidden data-done>
      <div class="invite-done_hero">
        <span class="invite-done_confetti" aria-hidden="true" data-confetti></span>
        <span class="invite-done_blob" data-blob>
          <PathIcon d="" variant="large" />
        </span>
        <h2 class="invite-steps_heading invite-done_title text-style-h2" tabindex="-1" data-heading data-title />
        <p class="invite-done_sub text-style-main" data-sub />
      </div>

      <div class="invite-done_extras" data-extras>
        <div class="invite-done_win">
          <span class="invite-done_win_icon">
            <PathIcon d="M5 12l5 5 9-10" />
          </span>
          <div class="invite-done_win_text">
            <p class="text-style-tiny">{invite.winner.slotId ? "Time that won" : "When"}</p>
            <p class="invite-done_win_time text-style-h4">{invite.winner.time}</p>
            <p class="text-style-small" data-win-sub />
          </div>
        </div>
      </div>

      <dl class="invite-done_summary" data-summary-list></dl>

      <div class="invite-done_link" data-link-box>
        <p class="invite-steps_label text-style-main">Your link</p>
        <p class="invite-done_url text-style-small" data-url />
        <p class="invite-reply_hint text-style-small">
          Keep it. It has your reply, and if the plan changes it updates here. No account needed.
        </p>
      </div>

      <div class="invite-done_buttons" data-actions>
        {invite.calendarHref && invite.signedIn && !invite.claimable && invite.planId ? (
          <ActionButton color={invite.pinned ? "green" : "white"} size="large" aria-pressed={invite.pinned ? "true" : "false"} data-pin>
            {invite.pinned ? "On your calendar" : "Add to my calendar"}
          </ActionButton>
        ) : invite.calendarHref ? (
          <ActionButton element="link" href={invite.calendarHref} color="white" size="large" download>
            {invite.calendarLabel ?? "Add to calendar"}
          </ActionButton>
        ) : null}
        <ActionButton color="yellow" size="large" data-copy>
          Copy my link
        </ActionButton>
      </div>

      <div class="invite-done_account" data-account>
        {invite.claimable && (
          <div class="invite-done_account_item">
            <p class="text-style-small">This reply is saved as a guest. Attach it to your account to see it in your Plans.</p>
            <ActionButton color="white" size="small" data-claim>
              Link this reply to my account
            </ActionButton>
          </div>
        )}
        {invite.signedIn && invite.friend === "friends" && (
          <p class="invite-done_account_item text-style-small">You and {invite.host.name} are friends.</p>
        )}
        {invite.signedIn && invite.friend && invite.friend !== "friends" && !invite.claimable && (
          <div class="invite-done_account_item">
            <ActionButton color="white" size="small" data-befriend disabled={invite.friend === "requested"}>
              {invite.friend === "requested" ? "Request sent" : `Add ${invite.host.name} as a friend`}
            </ActionButton>
          </div>
        )}
        {!invite.signedIn && (
          <p class="invite-done_account_item text-style-small">
            Already have an account?{" "}
            <a class="invite-done_login" href={`/login?next=${encodeURIComponent(`/p/${invite.slug}`)}`} data-login>Log in</a>{" "}
            to add {invite.host.name} as a friend and see this plan in your Plans.
          </p>
        )}
      </div>

      <ActionButton color="white" size="small" class="invite-done_change" data-change>
        Change my reply
      </ActionButton>
    </div>
  )
}

<script>
  import { cleanName, currentStep, doneCopy, edit, get, getInvite, subscribe, summaryRows, update, winnerMissed } from "@/lib/invite-store.ts";
  import { addHost, claimReply } from "@/lib/invite-repo.ts";
  import { setOnCalendar } from "@/lib/plans-repo.ts";
  import { setIconPath } from "@/lib/ui.ts";

  const confettiColors = ["red", "yellow", "green", "blue", "pink", "purple"];
  const check = "M5 12l5 5 9-10";
  const question = "M9 9a3 3 0 115 2c-1 1-2 1.5-2 3M12 18h.01";
  const cross = "M6 6l12 12M18 6L6 18";

  document.querySelectorAll<HTMLElement>("[data-done]").forEach((root) => {
    const $ = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const blob = $("[data-blob]");
    const confetti = $("[data-confetti]");
    const list = $("[data-summary-list]");
    const linkBox = $("[data-link-box]");
    const url = $("[data-url]");
    const actions = $("[data-actions]");
    const copy = $("[data-copy]");
    const extras = $("[data-extras]");
    const winSub = $("[data-win-sub]");
    const invite = getInvite();
    let wasDone = false;

    /** Turns a toggle button green and swaps its text while it is on. */
    const mark = (button: HTMLElement, on: boolean, offColor: string, onText: string, offText: string) => {
      button.classList.remove("green", offColor);
      button.classList.add(on ? "green" : offColor);
      button.setAttribute("aria-pressed", String(on));
      button.querySelector<HTMLElement>(".action-button_text")!.textContent = on ? onText : offText;
    };

    const burst = () => {
      confetti.replaceChildren(
        ...Array.from({ length: 16 }, (_, index) => {
          const angle = (index / 16) * Math.PI * 2;
          const distance = 4.5 + (index % 4) * 1.4;
          const piece = document.createElement("span");
          piece.className = `invite-done_piece ${confettiColors[index % 6]}`;
          piece.style.setProperty("--_x", `${(Math.cos(angle) * distance).toFixed(2)}rem`);
          piece.style.setProperty("--_y", `${(Math.sin(angle) * distance).toFixed(2)}rem`);
          piece.style.setProperty("--_r", `${index * 47}deg`);
          piece.style.setProperty("--_delay", `${(index % 4) * 30}ms`);
          return piece;
        }),
      );
    };

    root.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target.closest("[data-change]")) return edit();
      const befriend = target.closest<HTMLButtonElement>("[data-befriend]");
      if (befriend && !befriend.disabled) {
        const label = befriend.querySelector<HTMLElement>(".action-button_text")!;
        befriend.disabled = true;
        void addHost(invite.slug).then((result) => {
          const done: Record<string, string> = {
            sent: "Request sent",
            already_requested: "Request sent",
            accepted: "You're friends now",
            already_friends: "You're already friends",
          };
          const text = result.ok ? done[result.status] : undefined;
          label.textContent = text ?? "Couldn't send. Try again later.";
          if (!text) befriend.disabled = false;
          else befriend.classList.replace("white", "green");
        });
        return;
      }
      const pin = target.closest<HTMLButtonElement>("[data-pin]");
      if (pin && invite.planId) {
        const on = pin.getAttribute("aria-pressed") !== "true";
        const label = pin.querySelector<HTMLElement>(".action-button_text")!;
        const show = (value: boolean) => {
          pin.setAttribute("aria-pressed", String(value));
          pin.classList.remove("white", "green");
          pin.classList.add(value ? "green" : "white");
          label.textContent = value ? "On your calendar" : "Add to my calendar";
        };
        show(on);
        void setOnCalendar(invite.planId, on).then((result) => {
          if (!result.ok) show(!on);
        });
        return;
      }
      const claim = target.closest<HTMLButtonElement>("[data-claim]");
      if (claim && !claim.disabled && invite.token) {
        claim.disabled = true;
        void claimReply(invite.token).then((result) => {
          if (result.ok) location.href = `/p/${result.slug}`;
          else {
            claim.disabled = false;
            claim.querySelector<HTMLElement>(".action-button_text")!.textContent = "Couldn't link it. Try again.";
          }
        });
        return;
      }
      if (target.closest("[data-copy]")) {
        const s = get();
        void navigator.clipboard?.writeText(`${location.origin}${s.receipt}`).catch(() => {});
        update({ copied: true });
      }
    });

    subscribe(() => {
      const done = currentStep() === "done";
      if (!done) {
        wasDone = false;
        confetti.replaceChildren();
        return;
      }
      const s = get();
      const copyText = doneCopy();
      const going = s.rsvp !== "out";

      $("[data-title]").textContent = copyText.title;
      $("[data-sub]").textContent = copyText.sub;
      blob.dataset.rsvp = s.rsvp;
      setIconPath(blob, s.rsvp === "in" ? check : s.rsvp === "maybe" ? question : cross);

      list.replaceChildren(
        ...summaryRows().flatMap((row) => {
          const term = document.createElement("dt");
          term.className = "invite-done_term text-style-small";
          term.textContent = row.label;
          const value = document.createElement("dd");
          value.className = "invite-done_value text-style-small";
          value.textContent = row.value;
          return [term, value];
        }),
      );

      extras.hidden = !going;
      winSub.textContent = `${invite.winner.sub}${winnerMissed() ? ". Not one of your picks, change your reply if it does not work." : ""}`;
      linkBox.hidden = !going || !!invite.signedIn;
      actions.hidden = !going;
      copy.hidden = !!invite.signedIn;
      /* A guest who logs in comes back to their own page, so the reply carries over. */
      const login = root.querySelector<HTMLAnchorElement>("[data-login]");
      if (login && s.receipt) login.href = `/login?next=${encodeURIComponent(s.receipt)}`;
      winSub.hidden = !winSub.textContent;
      url.textContent = s.receipt ? `${location.origin}${s.receipt}` : "Saving your link…";
      mark(copy, s.copied, "yellow", "Link copied", "Copy my link");

      if (!wasDone && s.rsvp === "in" && cleanName()) burst();
      wasDone = true;
    });
  });
</script>

<style is:global>
  @layer components {
    .invite-done_hero {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
      text-align: center;
    }

    .invite-done_blob {
      --_color: var(--colors-vivid-green);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: calc(var(--avatar-xlarge) * 1.5);
      aspect-ratio: 1 / 1;
      border: var(--border-width-thick) solid var(--border-strong);
      border-radius: 58% 42% 55% 45% / 48% 56% 44% 52%;
      background-color: var(--_color);
      color: var(--colors-on-vivid);
      animation: invite-done-beat 2.4s ease-in-out infinite;

      &[data-rsvp="maybe"] {
        --_color: var(--colors-vivid-yellow);
      }
      &[data-rsvp="out"] {
        --_color: var(--colors-vivid-pink);
      }
    }

    .invite-done_sub {
      max-width: 26rem;
    }

    .invite-done_confetti {
      position: absolute;
      inset-inline-start: 50%;
      inset-block-start: calc(var(--avatar-xlarge) * 0.75);
      width: 0;
      height: 0;
      pointer-events: none;
    }

    .invite-done_piece {
      --_color: var(--colors-vivid-red);
      position: absolute;
      inset: 0;
      width: var(--space-2);
      aspect-ratio: 1 / 1;
      margin: calc(var(--space-2) * -0.5);
      border-radius: var(--radius-small);
      background-color: var(--_color);
      animation: invite-done-burst 0.9s var(--ease-out) var(--_delay, 0ms) both;

      &:nth-child(2n) {
        border-radius: var(--radius-round);
      }
      &.yellow {
        --_color: var(--colors-vivid-yellow);
      }
      &.green {
        --_color: var(--colors-vivid-green);
      }
      &.blue {
        --_color: var(--colors-vivid-blue);
      }
      &.pink {
        --_color: var(--colors-vivid-pink);
      }
      &.purple {
        --_color: var(--colors-vivid-purple);
      }
    }

    .invite-done_extras {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);

      &[hidden] {
        display: none;
      }
    }

    .invite-done_win {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-3) var(--space-4);
      border: var(--border-width-medium) solid var(--border-strong);
      border-radius: var(--radius-large);
      background-color: var(--status-free-background);
    }

    .invite-done_win_icon {
      display: inline-flex;
      flex: none;
      align-items: center;
      justify-content: center;
      width: var(--avatar-main);
      aspect-ratio: 1 / 1;
      border: var(--border-width-thick) solid var(--border-strong);
      border-radius: var(--radius-round);
      background-color: var(--status-free);
      color: var(--colors-on-vivid);
    }

    .invite-done_win_text {
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: var(--space-0);
      min-width: 0;
    }

    .invite-done_win_time {
      font-weight: var(--secondary-bold);
    }


    .invite-done_account {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      align-items: center;
      text-align: center;
    }

    .invite-done_account_item {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      align-items: center;
    }

    .invite-done_login {
      font-weight: var(--primary-bold);
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }

    .invite-done_summary {
      display: grid;
      grid-template-columns: max-content minmax(0, 1fr);
      gap: var(--space-2) var(--space-4);
      margin: 0;
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-main);
      background-color: var(--background);
    }

    .invite-done_term {
      display: block;
      color: var(--text-2);
      font-weight: var(--primary-bold);
    }

    .invite-done_value {
      display: block;
      margin: 0;
      font-weight: var(--primary-bold);
      text-align: end;
    }

    .invite-done_link {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: var(--space-3) var(--space-4);
      border: var(--border-width) solid var(--border-subtle);
      border-radius: var(--radius-main);
      background-color: var(--colors-secondary-yellow);

      &[hidden] {
        display: none;
      }
    }

    .invite-done_url {
      padding: var(--space-2) var(--space-3);
      border: var(--border-width) solid var(--border-subtle);
      border-radius: var(--radius-small);
      background-color: var(--background-3);
      font-weight: var(--primary-bold);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .invite-done_buttons {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);

      &[hidden] {
        display: none;
      }
      & > * {
        flex: 1 1 11rem;
      }
    }

    .invite-done_change {
      align-self: flex-start;
    }

    @keyframes invite-done-beat {
      0%,
      100% {
        scale: 1;
      }
      50% {
        scale: 1.06;
      }
    }

    @keyframes invite-done-burst {
      0% {
        opacity: 1;
        translate: 0 0;
        scale: 1;
      }
      100% {
        opacity: 0;
        translate: var(--_x) var(--_y);
        scale: 0.3;
        rotate: var(--_r);
      }
    }
  }
</style>
