---
import Icon from "@/components/media/Icon.astro";
import ActionButton from "@/components/item/ActionButton.astro";
import brand_full_logo_cropped from "@/assets/logo/brand-full-logo-cropped.svg";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const tabs = [
  { label: "How it works", href: "/#demo" },
  { label: "Discover", href: "/#pillars" },
  { label: "Features", href: "/#features" },
];
---

{
  render && (
    <div class="landing-nav_wrap">
      <header class="landing-nav_bar">
        <a class="landing-nav_logo" href="/" aria-label={SITE_NAME}>
          <Icon src={brand_full_logo_cropped} variant="full-width" />
        </a>
        <nav class="landing-nav_tabs" aria-label="Sections" data-tabs>
          {tabs.map((tab) => (
            <a class="landing-nav_tab text-style-small" href={tab.href}>
              {tab.label}
            </a>
          ))}
        </nav>
        <a class="landing-nav_link landing-nav_story text-style-small" href="/story" hidden>
          My Story
        </a>
        <a
          class="landing-nav_link landing-nav_github text-style-small"
          href="https://github.com/christopher560/whatstheplan"
          target="_blank"
          rel="noopener"
        >
          <svg class="landing-nav_icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"
            />
          </svg>
          <span class="landing-nav_github_text">GitHub</span>
        </a>
        <div class="landing-nav_actions">
          <a class="landing-nav_link text-style-small" href="/login">
            Log in
          </a>
          <ActionButton element="link" href="/signup" size="small" raised>
            Get started
          </ActionButton>
        </div>
      </header>
    </div>
  )
}

<script>
  const tabs = document.querySelector<HTMLElement>("[data-tabs]");
  const links = tabs ? [...tabs.querySelectorAll<HTMLAnchorElement>("a")] : [];
  const sections = links.map((link) =>
    document.getElementById(link.hash.slice(1)),
  );

  /* The tab for the last section whose top has passed about a third of the way down the screen. */
  const spy = () => {
    const line = window.innerHeight * 0.35;
    let current = -1;
    let best = -Infinity;
    sections.forEach((section, index) => {
      if (!section) return;
      const top = section.getBoundingClientRect().top;
      if (top <= line && top > best) {
        best = top;
        current = index;
      }
    });
    links.forEach((link, index) => {
      if (index === current) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    });
    const active = links[current];
    if (!tabs || !active) return tabs?.style.setProperty("--_show", "0");
    tabs.style.setProperty("--_x", `${active.offsetLeft}px`);
    tabs.style.setProperty("--_w", `${active.offsetWidth}px`);
    tabs.style.setProperty("--_show", "1");
  };

  if (tabs) {
    window.addEventListener("scroll", spy, { passive: true });
    window.addEventListener("resize", spy);
    spy();
  }
</script>

<style is:global>
  @layer components {
    .landing-nav_wrap {
      position: sticky;
      top: var(--space-2);
      z-index: 30;
      padding: var(--space-2) var(--space-3) 0;
    }

    .landing-nav_bar {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      max-width: 72.5rem;
      margin-inline: auto;
      padding: var(--space-2) var(--space-2) var(--space-2) var(--space-3);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-large);
      background-color: color-mix(in srgb, var(--colors-secondary-yellow) 14%, var(--background-3));
      backdrop-filter: blur(0.75rem);
    }

    .landing-nav_logo {
      display: block;
      flex: none;
      width: clamp(8.5rem, 28vw, 10rem);
    }

    .landing-nav_tabs {
      position: relative;
      isolation: isolate;
      display: none;
      gap: var(--space-0);
      padding: var(--space-1);
      border-radius: var(--radius-main);
      background-color: var(--background-muted);

      &::before {
        content: "";
        position: absolute;
        z-index: -1;
        inset-block: var(--space-1);
        left: 0;
        width: var(--_w, 0);
        translate: var(--_x, 0) 0;
        border: var(--border-width) solid var(--border);
        border-radius: 0.75rem;
        background-color: var(--background-3);
        opacity: var(--_show, 0);
        transition:
          translate var(--move-duration) var(--ease-out),
          width var(--move-duration) var(--ease-out),
          opacity var(--hover-duration) var(--hover-ease);
      }
      @media (width >= 64rem) {
        display: flex;
      }
    }

    .landing-nav_tab,
    .landing-nav_link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      min-height: var(--control-height-small);
      padding-inline: var(--space-2);
      border-radius: 0.75rem;
      color: var(--text-2);
      font-weight: var(--primary-bold);
      text-decoration: none;
      white-space: nowrap;
      transition:
        color var(--hover-duration) var(--hover-ease),
        background-color var(--hover-duration) var(--hover-ease);

      @media (hover: hover) {
        &:hover {
          background-color: color-mix(in srgb, var(--text) 8%, transparent);
          color: var(--text);
        }
      }
    }

    .landing-nav_tab {
      min-height: 2rem;
      padding-inline: var(--space-3);
    }

    .landing-nav_tab[aria-current="true"] {
      color: var(--text);
    }

    .landing-nav_github,
    .landing-nav_story {
      display: none;
      @media (width >= 64rem) {
        display: inline-flex;
      }
    }

    .landing-nav_story[hidden] {
      display: none;
    }

    .landing-nav_github_text {
      display: none;
      @media (width >= 90rem) {
        display: inline;
      }
    }

    .landing-nav_icon {
      width: var(--icon-main);
      height: var(--icon-main);
    }

    .landing-nav_actions {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      margin-inline-start: auto;
    }
  }
</style>
