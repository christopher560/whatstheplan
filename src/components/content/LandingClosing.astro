---
import ActionButton from "@/components/item/ActionButton.astro";
import AvatarStack from "@/components/item/AvatarStack.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <section class="landing-closing_wrap" aria-labelledby="landing-closing-title">
        <span class="landing-closing_chip one" aria-hidden="true">who’s in? 🙋</span>
        <span class="landing-closing_chip two" aria-hidden="true">Sat · 7:00 pm</span>
        <span class="landing-closing_chip three" aria-hidden="true">
          <AvatarStack
            size="small"
            people={[
              { initial: "M", color: "yellow" },
              { initial: "D", color: "blue" },
              { initial: "S", color: "pink" },
            ]}
          />
          3 going
        </span>
        <span class="landing-closing_chip four" aria-hidden="true">see you there</span>
        <div class="landing-closing_inner">
        <h2 id="landing-closing-title" class="landing-closing_title scroll-reveal">
          Your next plan is one link away.
        </h2>
        <ActionButton element="link" href="/signup" size="large" raised>
          Start planning, it's free
        </ActionButton>
        </div>
      </section>
)
}

<style is:global>
  @layer components {
    .landing-closing_wrap {
      position: relative;
      padding-block: clamp(3.5rem, 8vw, 7rem) clamp(2.5rem, 5vw, 4rem);
      overflow: hidden;
      border-radius: clamp(1.75rem, 4vw, 3rem) clamp(1.75rem, 4vw, 3rem) 0 0;
      background-color: color-mix(in srgb, var(--colors-vivid-orange) 38%, var(--background-3));
      text-align: center;
    }

    .landing-closing_inner {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-5);
      width: var(--site-width);
      max-width: 72.5rem;
      margin-inline: auto;
    }

    .landing-closing_title {
      position: relative;
      max-width: 51.25rem;
      font-family: var(--secondary-family);
      font-size: clamp(2.5rem, 7vw, 5.5rem);
      font-weight: var(--secondary-bold);
      letter-spacing: var(--letter-spacing-tight);
      line-height: 0.98;
      text-wrap: balance;
    }

    .landing-closing_wrap .action-button_wrap {
      position: relative;
    }

    .landing-closing_chip {
      position: absolute;
      display: none;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-3);
      border: var(--border-width-medium) solid var(--border);
      border-radius: var(--radius-round);
      background-color: var(--background-3);
      font-size: var(--text-small);
      font-weight: var(--primary-bold);
      white-space: nowrap;

      @media (width >= 72rem) {
        display: inline-flex;
      }
      &.one {
        left: 7%;
        top: 24%;
        rotate: -6deg;
      }
      &.two {
        right: 8%;
        top: 20%;
        rotate: 5deg;
        background-color: var(--colors-secondary-green);
      }
      &.three {
        left: 12%;
        bottom: 24%;
        rotate: 4deg;
      }
      &.four {
        right: 11%;
        bottom: 22%;
        rotate: -5deg;
        background-color: var(--colors-secondary-purple);
      }
    }
  }
</style>
