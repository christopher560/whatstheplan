---
import Panel from "@/components/wrapper/Panel.astro";
import ActionButton from "@/components/item/ActionButton.astro";
import Input from "@/components/form/Input.astro";
import Icon from "@/components/media/Icon.astro";
import icon_check from "@/assets/icons/icon_check.svg";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const rules = ["At least 8 characters", "Has a number", "Matches the confirmation"];
---

{
  render && (
    <Panel class="width-full" aria-labelledby="password-title" data-account-hide>
      <form class="password-card_wrap" data-password novalidate>
        <h2 id="password-title" class="password-card_title text-style-h5">
          Change password
        </h2>
        <Input
          variant="password"
          label="Current password"
          placeholder="Current password"
          name="current_password"
          autocomplete="current-password"
          data-current
        />
        <div class="password-card_new">
          <Input
            variant="password"
            label="New password"
            placeholder="New password"
            name="new_password"
            autocomplete="new-password"
            data-next
          />
          <div class="password-card_meter" aria-hidden="true" data-meter>
            <span class="password-card_bar" />
            <span class="password-card_bar" />
            <span class="password-card_bar" />
          </div>
          <p class="password-card_strength text-style-small" data-strength>
            Strength: choose a new password
          </p>
        </div>
        <Input
          variant="password"
          label="Confirm new password"
          placeholder="Confirm new password"
          name="confirm_password"
          autocomplete="new-password"
          data-confirm
        />
        <ul class="password-card_rules">
          {rules.map((rule) => (
            <li class="password-card_rule" data-rule>
              <span class="password-card_dot">
                <Icon src={icon_check} variant="small" />
              </span>
              <span class="text-style-small">{rule}</span>
            </li>
          ))}
        </ul>
        <div class="password-card_actions">
          <ActionButton type="submit" size="large" data-update disabled>
            Update password
          </ActionButton>
          <ActionButton color="white" size="large" data-show>
            Show passwords
          </ActionButton>
        </div>
        <p class="password-card_status text-style-small" role="status" hidden data-status />
      </form>
    </Panel>
  )
}

<script>
  import { changePassword } from "@/lib/account-repo.ts";

  document.querySelectorAll<HTMLFormElement>("[data-password]").forEach((form) => {
    const $ = <T extends HTMLElement>(selector: string) =>
      form.querySelector<T>(selector)!;
    const field = (selector: string) =>
      form.querySelector<HTMLInputElement>(`${selector} input, input${selector}`)!;

    const current = field("[data-current]");
    const next = field("[data-next]");
    const confirm = field("[data-confirm]");
    const inputs = [current, next, confirm];
    const rules = form.querySelectorAll<HTMLElement>("[data-rule]");
    const bars = form.querySelectorAll<HTMLElement>("[data-meter] > span");
    const strength = $("[data-strength]");
    const update = $<HTMLButtonElement>("[data-update]");
    const show = $<HTMLButtonElement>("[data-show]");
    const showText = show.querySelector<HTMLElement>(".action-button_text")!;
    const status = $("[data-status]");

    const checks = () => [
      next.value.length >= 8,
      /\d/.test(next.value),
      next.value.length > 0 && next.value === confirm.value,
    ];

    const level = () => {
      const value = next.value;
      if (!value) return 0;
      const score =
        (value.length >= 8 ? 1 : 0) +
        (value.length >= 12 ? 1 : 0) +
        (/\d/.test(value) && /[a-z]/i.test(value) ? 1 : 0) +
        (/[^a-z0-9]/i.test(value) ? 1 : 0);
      return score <= 1 ? 1 : score <= 2 ? 2 : 3;
    };

    const render = () => {
      const ok = checks();
      rules.forEach((rule, index) => rule.classList.toggle("ok", ok[index]));
      const strong = level();
      bars.forEach((bar, index) => {
        bar.className = `password-card_bar${index < strong ? ` level-${strong}` : ""}`;
      });
      strength.textContent = !next.value
        ? "Strength: choose a new password"
        : `Strength: ${["", "weak", "okay", "strong"][strong]}`;
      update.disabled = !(current.value.length > 0 && ok.every(Boolean));
    };

    form.addEventListener("input", () => {
      status.hidden = true;
      render();
    });

    show.addEventListener("click", () => {
      const hidden = current.type === "password";
      inputs.forEach((input) => {
        input.type = hidden ? "text" : "password";
      });
      showText.textContent = hidden ? "Hide passwords" : "Show passwords";
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (update.disabled) return;
      update.disabled = true;
      const result = await changePassword({ current: current.value, next: next.value });
      status.hidden = false;
      status.classList.toggle("error", !result.ok);
      status.textContent = result.ok ? "Password updated." : result.error;
      if (result.ok) inputs.forEach((input) => (input.value = ""));
      render();
    });

    render();
  });
</script>

<style is:global>
  @layer components {
    .password-card_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .password-card_title {
      font-weight: var(--secondary-bold);
    }

    .password-card_new {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .password-card_meter {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-1);
    }

    .password-card_bar {
      height: var(--space-1);
      border-radius: var(--radius-round);
      background-color: var(--border-subtle);
      transition: background-color var(--move-duration) var(--ease-out);

      &.level-1 {
        background-color: var(--colors-vivid-red);
      }
      &.level-2 {
        background-color: var(--colors-vivid-yellow);
      }
      &.level-3 {
        background-color: var(--colors-vivid-green);
      }
    }

    .password-card_strength {
      color: var(--text-2);
      font-weight: var(--primary-bold);
    }

    .password-card_rules {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .password-card_rule {
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }

    .password-card_dot {
      display: inline-flex;
      flex: none;
      align-items: center;
      justify-content: center;
      width: var(--icon-main);
      aspect-ratio: 1 / 1;
      border: var(--border-width-thick) solid var(--border-strong);
      border-radius: var(--radius-round);
      background-color: var(--background-3);
      color: transparent;
      font-size: var(--text-tiny);
      transition: background-color var(--hover-duration) var(--hover-ease);

      .password-card_rule.ok & {
        background-color: var(--status-free);
        color: var(--colors-on-vivid);
      }
    }

    .password-card_actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2);
    }

    .password-card_status {
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-main);
      background-color: var(--status-free-background);
      font-weight: var(--primary-bold);
      animation: password-card-pop var(--reveal-duration) var(--ease-spring-soft) backwards;

      &.error {
        background-color: var(--colors-secondary-red);
      }
      &[hidden] {
        display: none;
      }
    }

    @keyframes password-card-pop {
      from {
        opacity: 0.2;
        scale: 0.9;
      }
      to {
        opacity: 1;
        scale: 1;
      }
    }
  }
</style>
