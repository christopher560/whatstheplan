---
import type { DiscoverData } from "@/data/discover.ts";

interface Props {
  /** Everything the Discover components start from. */
  data?: DiscoverData;
}

const { data } = Astro.props;
---

{
  data && (
    <script
      is:inline
      type="application/json"
      id="discover-data"
      set:html={JSON.stringify(data).replace(/</g, "\\u003c")}
    />
  )
}

<script>
  import { poll } from "@/lib/live.ts";
  import { liveDiscover, livePulse } from "@/lib/live-repo.ts";
  import { applyLive, getData } from "@/lib/discover-store.ts";

  /* The Discover feed: spots, people and new groups arrive while it is open. */
  if (document.getElementById("discover-data")) {
    getData();
    poll({ pulse: () => livePulse("discover"), load: liveDiscover, apply: applyLive });
  }
</script>
