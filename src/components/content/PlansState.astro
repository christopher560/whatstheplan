---
import type { PlansHub } from "@/data/plans-hub.ts";

interface Props {
  /** Everything the plans components start from. */
  hub?: PlansHub;
}

const { hub } = Astro.props;
---

{
  hub && (
    <script
      is:inline
      type="application/json"
      id="plans-data"
      set:html={JSON.stringify(hub).replace(/</g, "\\u003c")}
    />
  )
}

<script>
  import { poll, reloadWhenIdle } from "@/lib/live.ts";
  import { livePlans, livePulse } from "@/lib/live-repo.ts";

  /* The Plans page cannot redraw a new invite or reply count in place, so it refreshes once the person is idle. */
  if (document.getElementById("plans-data")) {
    poll({ pulse: () => livePulse("plans"), load: livePlans, apply: reloadWhenIdle });
  }
</script>
