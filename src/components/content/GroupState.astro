---
import type { GroupPage } from "@/lib/group-store.ts";

interface Props {
  /** The group and viewer the components start from. */
  page?: GroupPage;
}

const { page } = Astro.props;
---

{
  page && (
    <script
      is:inline
      type="application/json"
      id="group-data"
      set:html={JSON.stringify(page).replace(/</g, "\\u003c")}
    />
  )
}

<script>
  import { poll, reloadWhenIdle } from "@/lib/live.ts";
  import { liveGroup, livePulse } from "@/lib/live-repo.ts";
  import { applyLive, group } from "@/lib/group-store.ts";

  /* A group page: who is going and the poll votes arrive while it is open (chat has its own checks). */
  if (document.getElementById("group-data")) {
    const id = group().id;
    poll({
      pulse: () => livePulse("group", id),
      load: () => liveGroup(id),
      apply: (next) => {
        if (applyLive(next) === "reload") reloadWhenIdle();
      },
    });
  }
</script>
