---
import ActionButton from "@/components/item/ActionButton.astro";
import Icon from "@/components/media/Icon.astro";
import PathIcon from "@/components/media/PathIcon.astro";
import { SITE_NAME } from "@/consts.ts";
import brand_full_logo_cropped from "@/assets/logo/brand-full-logo-cropped.svg";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Which form this is. Each has its own page. */
  mode?: "login" | "signup";
}

const { render = true, mode = "login" } = Astro.props;
const signup = mode === "signup";

const tabs = [
  { id: "signup", label: "Sign up", href: "/signup" },
  { id: "login", label: "Log in", href: "/login" },
];

/** The six boxes for the emailed code. */
const digits = [1, 2, 3, 4, 5, 6];
---

{
  render && (
    <div class="auth-form_wrap" data-auth={mode}>
      <a class="auth-form_brand" href="/" aria-label={SITE_NAME}>
        <Icon src={brand_full_logo_cropped} variant="full-width" />
      </a>

      <nav class="auth-form_tabs" aria-label="Sign up or log in">
        {tabs.map((tab) => (
          <a
            class="auth-form_tab text-style-small"
            href={tab.href}
            aria-current={tab.id === mode ? "page" : undefined}
          >
            {tab.label}
          </a>
        ))}
      </nav>

      <!-- Form -->
      <div class="auth-form_view" data-view="form">
        <h1 class="auth-form_title text-style-h4" tabindex="-1" data-heading>
          {signup ? "Create account" : "Welcome back"}
        </h1>

        <form class="auth-form_fields" method="post" novalidate data-form>
          <div class="field auth-form_field">
            <label class="field-label text-style-small" for="auth-email">Email</label>
            <input
              id="auth-email"
              class="field-control text-style-main"
              type="email"
              name="email"
              inputmode="email"
              autocomplete="email"
              placeholder="you@school.edu"
              data-email
            />
            <p class="auth-form_error text-style-small" hidden data-error="email" />
          </div>

          <div class="field auth-form_field">
            <div class="auth-form_label_row">
              <label class="field-label text-style-small" for="auth-password">Password</label>
              {!signup && (
                <button class="auth-form_text_button text-style-small" type="button" data-forgot>
                  Forgot it?
                </button>
              )}
            </div>
            <div class="auth-form_password">
              <input
                id="auth-password"
                class="field-control text-style-main"
                type="password"
                name="password"
                autocomplete={signup ? "new-password" : "current-password"}
                placeholder={signup ? "8+ characters" : "Your password"}
                data-password
              />
              <button
                class="auth-form_show text-style-small"
                type="button"
                aria-label="Show password"
                aria-pressed="false"
                data-show
              >
                Show
              </button>
            </div>
            <p class="auth-form_error text-style-small" hidden data-error="password" />
            {signup && (
              <div class="auth-form_strength">
                <div class="auth-form_meter" aria-hidden="true" data-meter data-level="0">
                  <span />
                  <span />
                  <span />
                  <span />
                </div>
                <span class="auth-form_strength_text text-style-small" data-strength />
              </div>
            )}
          </div>

          {signup && (
            <div class="auth-form_field">
              <label class="auth-form_check">
                <input class="auth-form_check_input" type="checkbox" name="terms" data-terms />
                <span class="auth-form_check_box" aria-hidden="true">
                  <PathIcon d="M5 12l5 5 9-10" variant="small" />
                </span>
                <span class="text-style-small">
                  I agree to the <a class="auth-form_link" href="#">terms</a> and{" "}
                  <a class="auth-form_link" href="#">privacy policy</a>
                </span>
              </label>
              <p class="auth-form_error text-style-small" hidden data-error="terms">
                Please agree to continue.
              </p>
            </div>
          )}

          <ActionButton type="submit" size="large" raised data-submit>
            {signup ? "Create account" : "Log in"}
          </ActionButton>
        </form>

        <p class="auth-form_divider text-style-small" aria-hidden="true">or</p>

        <ActionButton color="white" size="large" data-google>
          <svg slot="before" class="auth-form_google" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z" />
            <path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.5 5.8c4.4-4.1 7.1-10.1 7.1-17.5z" />
            <path fill="#FBBC05" d="M10.5 28.7c-.5-1.5-.8-3-.8-4.7s.3-3.2.8-4.7l-7.9-6.1C.9 16.4 0 20.1 0 24s.9 7.6 2.6 10.8l7.9-6.1z" />
            <path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.5-5.8c-2.1 1.4-4.8 2.3-8.4 2.3-6.3 0-11.6-4.1-13.5-9.8l-7.9 6.1C6.5 42.6 14.6 48 24 48z" />
          </svg>
          Continue with Google
        </ActionButton>
      </div>

      <!-- Ask for a reset code -->
      <div class="auth-form_view" hidden data-view="forgot">
        <button class="auth-form_back text-style-main" type="button" data-back>
          <span class="auth-form_back_arrow">
            <PathIcon d="M9 5l7 7-7 7" variant="small" />
          </span>
          Log in
        </button>
        <h1 class="auth-form_title text-style-h4" tabindex="-1" data-heading>Reset password</h1>
        <p class="auth-form_lead text-style-main">
          Enter your email and we will send you a 6-digit code.
        </p>
        <form class="auth-form_fields" method="post" novalidate data-forgot-form>
          <div class="field auth-form_field">
            <label class="field-label text-style-small" for="auth-reset-email">Email</label>
            <input
              id="auth-reset-email"
              class="field-control text-style-main"
              type="email"
              name="email"
              inputmode="email"
              autocomplete="email"
              placeholder="you@school.edu"
              data-reset-email
            />
            <p class="auth-form_error text-style-small" hidden data-error="reset" />
          </div>
          <ActionButton type="submit" size="large" raised data-reset-submit>
            Send code
          </ActionButton>
        </form>
      </div>

      <!-- Type the 6-digit code -->
      <div class="auth-form_view" hidden data-view="code">
        <button class="auth-form_back text-style-main" type="button" data-back>
          <span class="auth-form_back_arrow">
            <PathIcon d="M9 5l7 7-7 7" variant="small" />
          </span>
          Back
        </button>
        <span class="auth-form_blob blue">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="5" y="10" width="38" height="28" rx="6" />
            <path d="M7 14l17 12 17-12" />
          </svg>
        </span>
        <h1 class="auth-form_title text-style-h4" tabindex="-1" data-heading>Enter your code</h1>
        <p class="auth-form_lead text-style-main" role="status" data-code-text />
        <form class="auth-form_fields" method="post" novalidate data-code-form>
          <div class="field auth-form_field">
            <div class="auth-form_code" role="group" aria-label="6-digit code" data-code>
              {digits.map((n) => (
                <input
                  class="auth-form_digit field-control text-style-h4"
                  type="text"
                  inputmode="numeric"
                  pattern="[0-9]*"
                  autocomplete={n === 1 ? "one-time-code" : "off"}
                  aria-label={`Digit ${n} of 6`}
                  data-digit
                />
              ))}
            </div>
            <p class="auth-form_error text-style-small" hidden data-error="code" />
          </div>
          <ActionButton type="submit" size="large" raised data-code-submit>
            Verify
          </ActionButton>
        </form>
        <button class="auth-form_text_button center text-style-small" type="button" data-resend>
          Send a new code
        </button>
      </div>

      <!-- Choose a new password (after a reset code) -->
      <div class="auth-form_view" hidden data-view="newpass">
        <h1 class="auth-form_title text-style-h4" tabindex="-1" data-heading>Choose a new password</h1>
        <form class="auth-form_fields" method="post" novalidate data-newpass-form>
          <div class="field auth-form_field">
            <label class="field-label text-style-small" for="auth-new-password">New password</label>
            <div class="auth-form_password">
              <input
                id="auth-new-password"
                class="field-control text-style-main"
                type="password"
                name="new-password"
                autocomplete="new-password"
                placeholder="8+ characters"
                data-new-password
              />
              <button
                class="auth-form_show text-style-small"
                type="button"
                aria-label="Show password"
                aria-pressed="false"
                data-new-show
              >
                Show
              </button>
            </div>
            <p class="auth-form_error text-style-small" hidden data-error="newpass" />
            <div class="auth-form_strength">
              <div class="auth-form_meter" aria-hidden="true" data-new-meter data-level="0">
                <span />
                <span />
                <span />
                <span />
              </div>
              <span class="auth-form_strength_text text-style-small" data-new-strength />
            </div>
          </div>
          <ActionButton type="submit" size="large" raised data-newpass-submit>
            Update password
          </ActionButton>
        </form>
      </div>

      <!-- Done -->
      <div class="auth-form_view center" hidden data-view="done">
        <span class="auth-form_blob green">
          <PathIcon d="M5 12l5 5 9-10" variant="large" />
        </span>
        <h1 class="auth-form_title text-style-h4" tabindex="-1" data-heading data-done-title />
        <p class="auth-form_lead text-style-main" data-done-text />
        <ActionButton element="link" size="large" raised data-done-link>
          Continue
        </ActionButton>
      </div>
    </div>
  )
}

<script>
  import {
    logIn,
    requestPasswordReset,
    resendCode,
    safeNext,
    signInWithGoogle,
    signUp,
    updatePassword,
    verifyCode,
  } from "@/lib/auth-repo.ts";
  import type { AuthResult, CodePurpose } from "@/lib/auth-repo.ts";

  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const strengthWords = ["", "Weak", "Okay", "Good", "Strong"];
  const resendSeconds = 60;

  /** 0 for empty, then 1 to 4: length, more length, mixed case, a digit or symbol. */
  const strength = (password: string) => {
    if (!password) return 0;
    let score = 0;
    if (password.length >= 8) score += 1;
    if (password.length >= 12) score += 1;
    if (/[A-Z]/.test(password) && /[a-z]/.test(password)) score += 1;
    if (/[0-9]/.test(password) || /[^A-Za-z0-9]/.test(password)) score += 1;
    return Math.max(1, score);
  };

  document.querySelectorAll<HTMLElement>("[data-auth]").forEach((root) => {
    const mode = root.dataset.auth as "login" | "signup";
    const signup = mode === "signup";
    const $ = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const views = root.querySelectorAll<HTMLElement>("[data-view]");

    const form = $<HTMLFormElement>("[data-form]");
    const email = $<HTMLInputElement>("[data-email]");
    const password = $<HTMLInputElement>("[data-password]");
    const terms = root.querySelector<HTMLInputElement>("[data-terms]");
    const submit = $<HTMLButtonElement>("[data-submit]");
    const google = $<HTMLButtonElement>("[data-google]");
    const submitLabel = submit.querySelector<HTMLElement>(".action-button_text")!;
    const idleSubmit = submitLabel.textContent ?? "";

    const resetForm = $<HTMLFormElement>("[data-forgot-form]");
    const resetEmail = $<HTMLInputElement>("[data-reset-email]");
    const resetSubmit = $<HTMLButtonElement>("[data-reset-submit]");
    const resetLabel = resetSubmit.querySelector<HTMLElement>(".action-button_text")!;
    const idleReset = resetLabel.textContent ?? "";

    const codeForm = $<HTMLFormElement>("[data-code-form]");
    const codeBox = $("[data-code]");
    const digits = [...root.querySelectorAll<HTMLInputElement>("[data-digit]")];
    const codeSubmit = $<HTMLButtonElement>("[data-code-submit]");
    const codeLabel = codeSubmit.querySelector<HTMLElement>(".action-button_text")!;
    const resend = $<HTMLButtonElement>("[data-resend]");

    const newForm = $<HTMLFormElement>("[data-newpass-form]");
    const newPassword = $<HTMLInputElement>("[data-new-password]");
    const newSubmit = $<HTMLButtonElement>("[data-newpass-submit]");
    const newLabel = newSubmit.querySelector<HTMLElement>(".action-button_text")!;
    const idleNew = newLabel.textContent ?? "";

    const next = safeNext(new URLSearchParams(location.search).get("next"), "");
    /** Who the code was sent to and why. Kept in memory only. */
    let pending: { email: string; purpose: CodePurpose } | null = null;
    let timer = 0;

    const touched = new Set<string>();
    let tried = false;

    const open = (name: string) => {
      views.forEach((view) => (view.hidden = view.dataset.view !== name));
      root.querySelector<HTMLElement>(`[data-view="${name}"] [data-heading]`)?.focus();
    };

    /** Shows or clears one field's message and its red border. */
    const flag = (key: string, message: string | null, field?: HTMLElement) => {
      const note = root.querySelector<HTMLElement>(`[data-error="${key}"]`)!;
      if (message) note.textContent = message;
      note.hidden = !message;
      field?.setAttribute("aria-invalid", String(!!message));
    };

    const emailMessage = (value: string) =>
      emailPattern.test(value.trim()) ? null : value.trim() === "" ? "Add your email." : "That email looks off.";
    const passwordMessage = () =>
      signup
        ? password.value.length >= 8 ? null : "Use at least 8 characters."
        : password.value.length >= 1 ? null : "Enter your password.";

    /** Messages appear after a field is left or a submit was tried, never while typing the first time. */
    const check = () => {
      const visible = (key: string) => tried || touched.has(key);
      flag("email", visible("email") ? emailMessage(email.value) : null, email);
      flag("password", visible("password") ? passwordMessage() : null, password);
      if (terms) {
        flag("terms", tried && !terms.checked ? "Please agree to continue." : null);
        terms.closest("label")?.classList.toggle("invalid", tried && !terms.checked);
      }
    };

    const valid = () => !emailMessage(email.value) && !passwordMessage() && (!terms || terms.checked);

    const shake = (target: HTMLElement) => {
      target.classList.remove("shake");
      void target.offsetWidth;
      target.classList.add("shake");
    };

    /** Show or hide a password field, and fill its strength meter as it changes. */
    const wirePassword = (
      input: HTMLInputElement,
      show: HTMLElement,
      meter: HTMLElement | null,
      text: HTMLElement | null,
      onInput: () => void,
    ) => {
      show.addEventListener("click", () => {
        const showing = input.type === "password";
        input.type = showing ? "text" : "password";
        show.textContent = showing ? "Hide" : "Show";
        show.setAttribute("aria-label", showing ? "Hide password" : "Show password");
        show.setAttribute("aria-pressed", String(showing));
      });
      input.addEventListener("input", () => {
        onInput();
        if (!meter || !text) return;
        const level = strength(input.value);
        meter.dataset.level = String(level);
        text.textContent = strengthWords[level];
      });
    };

    const done = (title: string, text: string, label: string, href: string) => {
      $("[data-done-title]").textContent = title;
      $("[data-done-text]").textContent = text;
      const link = $<HTMLAnchorElement>("[data-done-link]");
      link.href = href;
      link.querySelector<HTMLElement>(".action-button_text")!.textContent = label;
      open("done");
    };

    /* ---------- the code view ---------- */

    const enteredCode = () => digits.map((digit) => digit.value).join("");

    const startCooldown = () => {
      window.clearInterval(timer);
      let left = resendSeconds;
      const paint = () => {
        resend.textContent = left > 0 ? `Send a new code in ${left}s` : "Send a new code";
        resend.disabled = left > 0;
      };
      paint();
      timer = window.setInterval(() => {
        left -= 1;
        paint();
        if (left <= 0) window.clearInterval(timer);
      }, 1000);
    };

    const showCode = (address: string, purpose: CodePurpose) => {
      pending = { email: address, purpose };
      $("[data-code-text]").textContent = `We sent a 6-digit code to ${address}. It can take a minute to arrive.`;
      digits.forEach((digit) => (digit.value = ""));
      flag("code", null);
      open("code");
      digits[0].focus();
      startCooldown();
    };

    const fillDigits = (value: string, from = 0) => {
      const clean = value.replace(/\D/g, "").slice(0, 6 - from);
      [...clean].forEach((char, offset) => (digits[from + offset].value = char));
      digits[Math.min(from + clean.length, 5)].focus();
      if (enteredCode().length === 6) codeForm.requestSubmit();
    };

    digits.forEach((digit, index) => {
      digit.addEventListener("input", () => {
        /* Autofill and paste can drop several digits into one box. */
        if (digit.value.length > 1 || /\D/.test(digit.value)) {
          const all = digit.value;
          digit.value = "";
          return fillDigits(all, index);
        }
        flag("code", null);
        if (digit.value && index < 5) digits[index + 1].focus();
        if (enteredCode().length === 6) codeForm.requestSubmit();
      });
      digit.addEventListener("keydown", (event) => {
        if (event.key === "Backspace" && !digit.value && index > 0) {
          digits[index - 1].value = "";
          digits[index - 1].focus();
        } else if (event.key === "ArrowLeft" && index > 0) digits[index - 1].focus();
        else if (event.key === "ArrowRight" && index < 5) digits[index + 1].focus();
      });
      digit.addEventListener("paste", (event) => {
        event.preventDefault();
        fillDigits(event.clipboardData?.getData("text") ?? "", index);
      });
      digit.addEventListener("focus", () => digit.select());
    });

    codeForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!pending || codeSubmit.disabled) return;
      if (enteredCode().length < 6) {
        flag("code", "Enter all 6 digits.");
        return shake(codeBox);
      }
      codeSubmit.disabled = true;
      codeLabel.textContent = "Checking…";
      const result = await verifyCode({ email: pending.email, token: enteredCode(), purpose: pending.purpose });
      codeSubmit.disabled = false;
      codeLabel.textContent = "Verify";
      if (!result.ok) {
        flag("code", result.error);
        shake(codeBox);
        digits.forEach((digit) => (digit.value = ""));
        return digits[0].focus();
      }
      window.clearInterval(timer);
      if (pending.purpose === "recovery") return open("newpass");
      done(
        "You are in!",
        "Two quick questions and you are set.",
        "Let's set you up",
        "next" in result ? result.next : "/app/onboarding",
      );
    });

    resend.addEventListener("click", async () => {
      if (!pending) return;
      resend.disabled = true;
      const result = await resendCode(pending);
      if (!result.ok) {
        flag("code", result.error);
        resend.disabled = false;
        return;
      }
      flag("code", null);
      startCooldown();
      digits[0].focus();
    });

    /* ---------- the form ---------- */

    const busy = (on: boolean) => {
      submit.disabled = on;
      google.disabled = on;
      submitLabel.textContent = on ? (signup ? "Creating…" : "Logging in…") : idleSubmit;
    };

    const finish = (result: AuthResult) => {
      busy(false);
      if (!result.ok) {
        flag("password", result.error, password);
        return password.focus();
      }
      if ("checkEmail" in result) return showCode(email.value.trim(), "signup");
      done(
        signup ? "You are in!" : "Welcome back!",
        signup ? "Two quick questions and you are set." : "Your plans and friends are right where you left them.",
        signup ? "Let's set you up" : "Go to my plans",
        result.next,
      );
    };

    wirePassword(password, $("[data-show]"), root.querySelector("[data-meter]"), root.querySelector("[data-strength]"), check);
    wirePassword(newPassword, $("[data-new-show]"), $("[data-new-meter]"), $("[data-new-strength]"), () =>
      flag("newpass", null, newPassword),
    );

    email.addEventListener("blur", () => (touched.add("email"), check()));
    password.addEventListener("blur", () => (touched.add("password"), check()));
    email.addEventListener("input", check);
    terms?.addEventListener("change", check);

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      tried = true;
      check();
      if (!valid()) {
        shake(form);
        return (emailMessage(email.value) ? email : password).focus();
      }
      busy(true);
      const input = { email: email.value.trim(), password: password.value, next: next || undefined };
      finish(signup ? await signUp(input) : await logIn(input));
    });

    google.addEventListener("click", async () => {
      busy(true);
      finish(await signInWithGoogle({ mode, next: next || undefined }));
    });

    /* ---------- forgot password ---------- */

    root.querySelector("[data-forgot]")?.addEventListener("click", () => {
      resetEmail.value = email.value;
      open("forgot");
      resetEmail.focus();
    });
    root.querySelectorAll("[data-back]").forEach((button) =>
      button.addEventListener("click", () => {
        window.clearInterval(timer);
        open(pending?.purpose === "recovery" ? "forgot" : "form");
      }),
    );

    resetForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const message = emailMessage(resetEmail.value);
      flag("reset", message, resetEmail);
      if (message) return resetEmail.focus();
      resetSubmit.disabled = true;
      resetLabel.textContent = "Sending…";
      const result = await requestPasswordReset({ email: resetEmail.value.trim() });
      resetSubmit.disabled = false;
      resetLabel.textContent = idleReset;
      if (!result.ok) return flag("reset", result.error, resetEmail);
      showCode(resetEmail.value.trim(), "recovery");
    });

    newForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (newPassword.value.length < 8) {
        flag("newpass", "Use at least 8 characters.", newPassword);
        shake(newForm);
        return newPassword.focus();
      }
      newSubmit.disabled = true;
      newLabel.textContent = "Updating…";
      const result = await updatePassword({ password: newPassword.value });
      newSubmit.disabled = false;
      newLabel.textContent = idleNew;
      if (!result.ok) return flag("newpass", result.error, newPassword);
      done(
        "Password updated",
        "You are signed in with your new password.",
        "Go to my plans",
        "next" in result ? result.next : "/app/dashboard",
      );
    });
  });
</script>

<style is:global>
  @layer components {
    .auth-form_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      width: 100%;
      max-width: 27.5rem;
      padding: var(--space-5);
      border: var(--border-width) solid var(--border-subtle);
      border-radius: var(--radius-xlarge);
      background-color: var(--background-3);
      animation: auth-form-rise var(--enter-duration) var(--ease-out) backwards;
    }

    .auth-form_brand {
      display: block;
      width: clamp(8rem, 40%, 10rem);
    }

    .auth-form_tabs {
      display: flex;
      align-self: flex-start;
      gap: var(--space-0);
      padding: var(--space-0);
