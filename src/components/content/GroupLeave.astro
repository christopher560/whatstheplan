---
import Panel from "@/components/wrapper/Panel.astro";
import ActionButton from "@/components/item/ActionButton.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <Panel aria-labelledby="group-leave-title" data-leave>
      <h2 id="group-leave-title" class="group-leave_title text-style-h4">Not feeling it?</h2>
      <p class="group-leave_text text-style-small">
        You can leave anytime. Nobody gets a notification, just a note in the chat.
      </p>
      <div class="group-leave_confirm" hidden data-confirm>
        <ActionButton color="red" data-yes>
          Yes, leave
        </ActionButton>
        <ActionButton color="white" data-stay>
          Stay
        </ActionButton>
      </div>
      <ActionButton color="white" data-ask>
        Leave group
      </ActionButton>
    </Panel>
  )
}

<script>
  import { askLeave, confirmLeave, get, subscribe } from "@/lib/group-store.ts";

  document.querySelectorAll<HTMLElement>("[data-leave]").forEach((root) => {
    const confirm = root.querySelector<HTMLElement>("[data-confirm]")!;
    const ask = root.querySelector<HTMLElement>("[data-ask]")!;

    ask.addEventListener("click", () => askLeave(true));
    root.querySelector("[data-stay]")!.addEventListener("click", () => askLeave(false));
    root.querySelector("[data-yes]")!.addEventListener("click", confirmLeave);

    subscribe(() => {
      const asking = get().leaveAsk;
      confirm.hidden = !asking;
      ask.hidden = asking;
    });
  });
</script>

<style is:global>
  @layer components {
    .group-leave_title {
      font-weight: var(--secondary-bold);
    }

    .group-leave_text {
      color: var(--text-2);
    }

    .group-leave_confirm {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);

      &[hidden] {
        display: none;
      }
      & > * {
        flex: 1 1 7rem;
      }
    }

    .panel_wrap > .action-button_wrap[hidden] {
      display: none;
    }
  }
</style>
