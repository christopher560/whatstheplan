---
import LandingLayout from "@/layouts/LandingLayout.astro";
import LandingNav from "@/components/content/LandingNav.astro";
import LandingHero from "@/components/content/LandingHero.astro";
import LandingTour from "@/components/section/LandingTour.astro";
import LandingPillars from "@/components/content/LandingPillars.astro";
import LandingFeatures from "@/components/content/LandingFeatures.astro";
import LandingOccasions from "@/components/content/LandingOccasions.astro";
import LandingFaq from "@/components/content/LandingFaq.astro";
import LandingClosing from "@/components/content/LandingClosing.astro";
---

<LandingLayout>
  <LandingNav slot="nav" />
  <!-- Hero -->
  <LandingHero />
  <!-- How it works -->
  <LandingTour />
  <!-- Plan and Discover -->
  <LandingPillars />
  <!-- Features -->
  <LandingFeatures />
  <!-- Occasions -->
  <LandingOccasions />
  <!-- FAQ -->
  <LandingFaq />
  <!-- Closing call to action and footer -->
  <LandingClosing />
</LandingLayout>
