---
import AuthLayout from "@/layouts/AuthLayout.astro";
import AuthForm from "@/components/content/AuthForm.astro";
import AuthShowcase from "@/components/content/AuthShowcase.astro";

/* Opened from the link in the reset email, after /auth/callback has signed the person in. */
export const prerender = false;
---

<AuthLayout title="Choose a new password">
  <!-- Reset password -->
  <AuthForm mode="reset" />
  <AuthShowcase slot="aside" />
</AuthLayout>
