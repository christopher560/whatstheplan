---
import InvitePage from "@/components/content/InvitePage.astro";
import { readInvite } from "@/lib/invite-db.ts";
import { nearestAccent } from "@/utils/avatar-accent.ts";

/* Depends on the plan and on who is looking, so it renders on each request. */
export const prerender = false;

const { slug } = Astro.params;
const invite = /^[a-z0-9-]{8,80}$/.test(slug ?? "")
  ? await readInvite(Astro.locals.supabase, slug!, !!Astro.locals.user)
  : null;
if (!invite) return Astro.redirect("/404");
/* The host does not reply to their own plan; they manage it. */
/* A signed-in visitor replies as themselves, with their own name and color. */
const profile = Astro.locals.profile;
if (Astro.locals.user && !invite.mine && profile) {
  invite.mine = {
    rsvp: null,
    name: profile.first_name || (profile.username ? `@${profile.username}` : ""),
    color: nearestAccent(profile.avatar_color),
    plusOne: "",
    host: false,
  };
}
if (invite.mine?.host) return Astro.redirect(`/app/plans/${invite.planId}`);
Astro.response.headers.set("Cache-Control", "private, no-store");
---

<InvitePage invite={invite} />
