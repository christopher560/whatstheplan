---
import DashboardLayout from "@/layouts/DashbaordLayout.astro";
import DashboardSection from "@/components/wrapper/DashboardSection.astro";
import DashboardColumns from "@/components/wrapper/DashboardColumns.astro";
import DashboardHeader from "@/components/content/DashboardHeader.astro";
import PlanBuilder from "@/components/content/PlanBuilder.astro";
import PlanBubbles from "@/components/content/PlanBubbles.astro";
import InviteList from "@/components/content/InviteList.astro";
import BudgetCard from "@/components/content/BudgetCard.astro";
import FreeTonightCard from "@/components/content/FreeTonightCard.astro";
import OverlapCard from "@/components/content/OverlapCard.astro";
import { readBuilderFriends } from "@/lib/plans-db.ts";
import { readHome } from "@/lib/home-db.ts";
import { nowFor } from "@/utils/now.ts";

/* Depends on who is signed in, so it renders on each request. */
export const prerender = false;

const profile = Astro.locals.profile;
const name = profile?.first_name || (profile?.username ? `@${profile.username}` : "there");
const [home, friends] = await Promise.all([
  readHome(Astro.locals.supabase, Astro.locals.user!.id, name, Astro.cookies.get("tz")?.value, nowFor(Astro.cookies)),
  readBuilderFriends(Astro.locals.supabase),
]);
const { freeNow, plans, invites, budget, tonight, overlap } = home;
/* Friends free tonight can be sent straight to the plan builder. */
const tonightWithIds = tonight.map((entry) => ({ ...entry, id: friends.find((friend) => friend.name === entry.name)?.id }));
---

<DashboardLayout title="Dashboard">
  <!-- Home -->
  <DashboardSection paddingTop="small" paddingBottom="small">
    <DashboardColumns>
      <DashboardHeader name={name} people={freeNow.people} summary={freeNow.summary} />
      <PlanBuilder friends={friends} />
      <PlanBubbles plans={plans} />
      <InviteList invites={invites} />
      <Fragment slot="rail">
        <BudgetCard {...budget} />
        <FreeTonightCard friends={tonightWithIds} />
        <OverlapCard friends={overlap} />
      </Fragment>
    </DashboardColumns>
  </DashboardSection>
</DashboardLayout>
