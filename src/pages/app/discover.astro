---
import DashboardLayout from "@/layouts/DashbaordLayout.astro";
import DashboardSection from "@/components/wrapper/DashboardSection.astro";
import Panel from "@/components/wrapper/Panel.astro";
import ActionButton from "@/components/item/ActionButton.astro";
import DiscoverState from "@/components/content/DiscoverState.astro";
import DiscoverHeader from "@/components/content/DiscoverHeader.astro";
import DiscoverFinder from "@/components/content/DiscoverFinder.astro";
import DiscoverBrowse from "@/components/content/DiscoverBrowse.astro";
import DiscoverHost from "@/components/content/DiscoverHost.astro";
import DiscoverKnow from "@/components/content/DiscoverKnow.astro";
import DiscoverSafety from "@/components/content/DiscoverSafety.astro";
import { readDiscover } from "@/lib/discover-db.ts";
import { nowFor } from "@/utils/now.ts";

/* Depends on who is signed in, so it renders on each request. */
export const prerender = false;

const result = await readDiscover(
  Astro.locals.supabase,
  Astro.locals.user!.id,
  Astro.cookies.get("tz")?.value,
  nowFor(Astro.cookies),
);
const data = result.status === "ok" ? result.data : null;
---

<DashboardLayout title="Discover">
  <!-- Discover -->
  <DashboardSection paddingTop="small" paddingBottom="small" gap="6">
    {
      data ? (
        <>
          <DiscoverState data={data} />
          <DiscoverHeader data={data} />
          <DiscoverFinder />
          <DiscoverBrowse days={data.days} />
          <DiscoverHost places={data.places ?? []} />
          <DiscoverKnow />
          <DiscoverSafety />
        </>
      ) : result.status === "needs_location" ? (
        <Panel variant="tint" tint="yellow" aria-labelledby="discover-gate-title">
          <h1 id="discover-gate-title" class="text-style-h3">Meet your people.</h1>
          <p class="text-style-main">
            Tell us your town and we will show groups near you. We only keep the town, never where you are right now.
          </p>
          <div>
            <ActionButton element="link" href="/app/account#location-title" color="ink">
              Set my town
            </ActionButton>
          </div>
        </Panel>
      ) : (
        <Panel variant="tint" tint="blue" aria-labelledby="discover-gate-title">
          <h1 id="discover-gate-title" class="text-style-h3">Discover isn't open for your age group yet.</h1>
          <p class="text-style-main">
            Meeting new people nearby is for adults 18 and over right now. Your friends, plans and calendar work
            the same as always.
          </p>
          <div>
            <ActionButton element="link" href="/app/dashboard#builder" color="ink">
              Make a plan with friends
            </ActionButton>
          </div>
        </Panel>
      )
    }
  </DashboardSection>
</DashboardLayout>
