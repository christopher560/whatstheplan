---
import DashboardLayout from "@/layouts/DashbaordLayout.astro";
import DashboardSection from "@/components/wrapper/DashboardSection.astro";
import DashboardColumns from "@/components/wrapper/DashboardColumns.astro";
import CalendarState from "@/components/content/CalendarState.astro";
import CalendarHeader from "@/components/content/CalendarHeader.astro";
import FriendOverlap from "@/components/content/FriendOverlap.astro";
import AvailabilityGrid from "@/components/content/AvailabilityGrid.astro";
import PlansThisWeek from "@/components/content/PlansThisWeek.astro";
import WeekSummary from "@/components/content/WeekSummary.astro";
import ShareCard from "@/components/content/ShareCard.astro";
import ImportCard from "@/components/content/ImportCard.astro";
import { readCalendar } from "@/lib/availability-db.ts";
import { readCalendarFriends } from "@/lib/friends-db.ts";
import { nowFor } from "@/utils/now.ts";
import { readCalendarPlans } from "@/lib/plans-db.ts";

/* Depends on who is signed in, so it renders on each request. */
export const prerender = false;

const now = nowFor(Astro.cookies);
const [calendar, friends, plans] = await Promise.all([
  readCalendar(Astro.locals.supabase, Astro.locals.user!.id, now),
  readCalendarFriends(Astro.locals.supabase, now),
  readCalendarPlans(Astro.locals.supabase, Astro.locals.user!.id, Astro.cookies.get("tz")?.value || "UTC"),
]);
calendar.plans = plans;
/* Start with up to two friends picked, so there is something to compare at once. */
calendar.friends = friends;
calendar.who = friends.slice(0, 2).map((friend) => friend.id);
---

<DashboardLayout title="Your calendar">
  <!-- Calendar -->
  <DashboardSection paddingTop="small" paddingBottom="small" gap="5">
    <CalendarState data={calendar} />
    <CalendarHeader weekStart={calendar.weekStart} />
    <FriendOverlap friends={calendar.friends} who={calendar.who} />
    <DashboardColumns>
      <AvailabilityGrid
        weekStart={calendar.weekStart}
        today={calendar.today}
        cells={calendar.cells}
      />
      <Fragment slot="rail">
        <PlansThisWeek />
        <WeekSummary />
        <ShareCard share={calendar.share} />
        <ImportCard />
      </Fragment>
    </DashboardColumns>
  </DashboardSection>
</DashboardLayout>
